# Secrets for the Tapo energy collector. Copy to .env (local test) or
# /etc/tapo-collector/collector.env (Linux service) and restrict access:  chmod 600 <file>
# NEVER commit the real file.

# The TP-Link / Tapo app account that the plugs are registered to.
TAPO_USERNAME=
TAPO_PASSWORD=

# Ingestion token issued on the website server with:
#   docker compose exec app node scripts/admin.mjs energy-token create workshop-pc
ENERGY_API_TOKEN=

# Optional: overrides upload.endpoint_url from config.yaml
# ENERGY_API_URL=https://YOUR-WEBSITE/api/energy/measurements
