# Auto detect text files and perform LF normalization
* text=auto
# Files executed on Linux must keep LF line endings, also when checked out on Windows
*.sh text eol=lf
*.service text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
# PowerShell scripts for the Windows option
*.ps1 text eol=crlf
